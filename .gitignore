# Local paper stack state (tools/paper/up.ps1): pids, logs, generated secrets
.paper/

# Single-user web on this PC (scripts/windows): paper book, Real public key, logs. No secrets.
.local-web/

# Updater signing key (docs/release/desktop.md): only the public half goes into tauri.conf.json
*.key

# --- Defense in depth: credentials and artifacts never belong in a public repo ---
# Env variants (apps/web and apps/desktop already ignore their own; this covers stray copies).
.env.*
!.env.example
