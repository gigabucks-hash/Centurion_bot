{
  "N-01": {
    "type": "proposal.created",
    "when": "kind=buy_pick, first_buy=false",
    "title_key": "notif.pick_pending.title",
    "body_key": "notif.pick_pending.body",
    "vars": [
      "coin",
      "strategy",
      "sol",
      "mm_ss"
    ],
    "push": true,
    "actions": {
      "practice": [
        "approve",
        "skip",
        "open"
      ],
      "real": [
        "open"
      ]
    }
  },
  "N-02": {
    "type": "proposal.created",
    "when": "kind=buy_pick, first_buy=true",
    "title_key": "notif.first_buy.title",
    "body_key": "notif.first_buy.body",
    "vars": [
      "coin",
      "strategy",
      "sol",
      "mm_ss"
    ],
    "push": true,
    "actions": {
      "practice": [
        "approve",
        "skip",
        "open"
      ],
      "real": [
        "open"
      ]
    }
  },
  "N-03": {
    "type": "proposal.approved",
    "when": "decided_via ≠ this device (in-app only)",
    "title_key": "notif.approved.title",
    "body_key": "notif.approved.body",
    "vars": [
      "coin"
    ],
    "push": false,
    "actions": {}
  },
  "N-04": {
    "type": "position.opened",
    "when": "",
    "title_key": "notif.filled.title",
    "body_key": "notif.filled.body",
    "vars": [
      "coin",
      "sol",
      "price"
    ],
    "push": true,
    "actions": {
      "practice": [
        "open"
      ],
      "real": [
        "open"
      ]
    }
  },
  "N-05": {
    "type": "— (no wire type in v1.1)",
    "when": "proposed: order.failed {reason}",
    "title_key": "notif.failed.title",
    "body_key": "notif.failed.body",
    "vars": [
      "coin",
      "reason"
    ],
    "push": true,
    "actions": {
      "practice": [
        "open"
      ],
      "real": [
        "open"
      ]
    }
  },
  "N-06": {
    "type": "proposal.rejected",
    "when": "UI label Skipped; in-app only",
    "title_key": "notif.skipped.title",
    "body_key": "notif.skipped.body",
    "vars": [
      "coin",
      "reason"
    ],
    "push": false,
    "actions": {}
  },
  "N-07": {
    "type": "proposal.expired",
    "when": "expire_reason → expire_reason.<r>.detail (uses vars.strategy) as {reason}",
    "title_key": "notif.expired.title",
    "body_key": "notif.expired.body",
    "vars": [
      "coin",
      "reason"
    ],
    "push": true,
    "actions": {
      "practice": [
        "open"
      ],
      "real": [
        "open"
      ]
    }
  },
