# Copy to `.env.local` (git-ignored) and edit. Never commit real secrets: none of these are needed for the mock build.
# The app runs with every value unset. These only switch it to the real backend, widen the owner allowlist, or enable
# dev/demo tooling.

# --- Data source -------------------------------------------------------------
# mock (default): in-memory BFF in app/api/v1, seeded data, no network. http: forward to the Rust/Node backend.
DATA_SOURCE=mock
# Backend base URL, no trailing slash (only read when DATA_SOURCE=http). Default http://localhost:8080.
API_BASE_URL=http://localhost:8080

# --- Auth --------------------------------------------------------------------
# Comma-separated base58 owner wallets allowed to sign in (SIWS). Default: the mock owner wallet only.
# Public keys, not secrets.
OWNER_WALLETS=
# 1 = allow the session cookie over plain http in a production build (`next start` locally, or behind a proxy without
# TLS). Without it the browser drops the Secure cookie and every app page 307s back to /login.
CENTURION_INSECURE_COOKIES=
# 0 = disable the auth gate for local perf/screenshot runs (never in production).
CENTURION_AUTH_GATE=
# Optional sign-in methods (off unless "true"). The MVP ships wallet SIWS only.
NEXT_PUBLIC_AUTH_EMAIL_OTP_ENABLED=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_AUTH_APPLE_ENABLED=
NEXT_PUBLIC_AUTH_TELEGRAM_OIDC_ENABLED=
# Multi-user onboarding presets on /welcome (off: private app, no sign-up copy).
NEXT_PUBLIC_AUTH_ONBOARDING_ENABLED=
# Google Identity Services client id (public); only used when the Google button is enabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Real SOL gate (paper-trading thresholds before Real is offered) ---------
CENTURION_REAL_GATE_MIN_PAPER_DAYS=
CENTURION_REAL_GATE_MIN_PAPER_TRADES=

# --- Dev / demo tooling ------------------------------------------------------
# 1 = run the two "Real" mock seeds in Real mode (dev/tests only; `npm test` sets this itself).
CENTURION_MOCK_REAL_DEMO=
# 1 = hide the dev badge for design-QA screenshots.
CENTURION_QA_SHOTS=
# Canonical public URL for metadata/OG images. Default http://localhost:3100.
NEXT_PUBLIC_SITE_URL=
# `npm run screenshots`: app base URL and the Chrome/Edge executable (default /usr/bin/google-chrome).
BASE=
CHROME_PATH=
