{
  "name": "@centurion/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "node scripts/run-tests.mjs",
    "audit": "npm audit --audit-level=moderate",
    "audit:osv": "osv-scanner scan --lockfile package-lock.json",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit",
    "mcp": "node --experimental-strip-types mcp/stdio.ts",
    "mcp:http": "node --experimental-strip-types mcp/http.ts"
  },
  "dependencies": {
    "@centurion/contracts": "file:../../packages/contracts",
    "@centurion/design-tokens": "file:../../packages/design-tokens",
    "@centurion/i18n": "file:../../packages/i18n",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tanstack/react-virtual": "3.14.24",
    "clsx": "2.1.1",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.67.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-security": "4.2.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
