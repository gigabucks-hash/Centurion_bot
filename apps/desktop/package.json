{
  "name": "@centurion/desktop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "csp:logo": "node scripts/csp-logo-origin.mjs",
    "tauri:dev:backend": "node scripts/csp-logo-origin.mjs && tauri dev --config src-tauri/tauri.logo-csp.json",
    "tauri:build:backend": "node scripts/csp-logo-origin.mjs && tauri build --config src-tauri/tauri.logo-csp.json",
    "test:ui": "node --experimental-strip-types --test scripts/ui-format.test.mjs scripts/hold-reset.test.mjs scripts/coin-avatar.test.mjs scripts/strategy-gate.test.mjs scripts/pnl-report.test.mjs scripts/update-check.test.mjs scripts/version-check.test.mjs scripts/connection-check.test.mjs scripts/updater-check.test.mjs scripts/real-limits.test.mjs scripts/paper-session.test.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:updater": "node scripts/check-updater.mjs",
    "typecheck:pinned": "scripts/tsc-pinned.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "1.71.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.7"
  }
}
