{
  "name": "@centurion/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "csp:logo": "node scripts/csp-logo-origin.mjs",
    "tauri:dev:backend": "node scripts/csp-logo-origin.mjs && tauri dev --config src-tauri/tauri.logo-csp.json",
    "tauri:build:backend": "node scripts/csp-logo-origin.mjs && tauri build --config src-tauri/tauri.logo-csp.json",
    "test:ui": "node --test scripts/ui-format.test.mjs scripts/hold-reset.test.mjs scripts/coin-avatar.test.mjs scripts/strategy-gate.test.mjs",
    "typecheck:pinned": "scripts/tsc-pinned.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@tauri-apps/api": "^2.9.0",
    "lightweight-charts": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
