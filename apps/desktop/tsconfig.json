{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@sentra/contracts/wire": ["../../packages/contracts/src/wire/index.ts"],
      "@sentra/i18n/*": ["../../packages/i18n/*"]
    }
  },
  "include": ["src", "../../packages/contracts/src/wire"]
}
