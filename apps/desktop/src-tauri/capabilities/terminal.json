{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "terminal",
  "description": "Main terminal window: full (paper) trading actions + window management.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-get-snapshot",
    "allow-get-candles",
    "allow-approve-signal",
    "allow-skip-signal",
    "allow-request-sell",
    "allow-confirm-sell",
    "allow-open-chart-window",
    "allow-open-activity-window",
    "allow-approve-many",
    "allow-open-approval-window",
    "allow-set-settings",
    "allow-focus-main-for-signal",
    "allow-hide-approval-popup",
    "allow-set-strategy-paused",
    "allow-reset-practice",
    "allow-get-coin-timeline",
    "allow-get-exit-reason-stats",
    "allow-refresh-quote",
    "allow-auth-status",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-patch-strategy"
  ]
}
