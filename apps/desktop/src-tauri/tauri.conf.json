{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Centurion Trade",
  "version": "0.3.0",
  "identifier": "com.centuriontrade.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Centurion Trade",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "category": "Finance",
    "publisher": "Centurion Trade",
    "copyright": "Copyright © 2026 Centurion Trade",
    "shortDescription": "Solana trading terminal",
    "longDescription": "Centurion Trade for Windows. Paper trading, and Real trading signed by your own wallet.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "linux": { "deb": { "depends": [], "desktopTemplate": "linux/main.desktop.hbs" } },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/gigabucks-hash/Centurion_bot/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNTdCODQwQjQwRUFBMjIKUldRaXFnNjBRTGhYTDlPQ2Nmc3U2M1VWZmIrTWN5Z3RGMm9iaTFFaFpoME1UZ1AySzlzcU9xVEYK"
    }
  }
}
