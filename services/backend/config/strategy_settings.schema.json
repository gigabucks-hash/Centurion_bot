{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentra.local/schemas/strategy-settings.v1.1.4.json",
  "title": "Strategy settings v1.1.4",
  "description": "snake_case keys. Percentages/ratios/counts/USD are JSON numbers; SOL amounts are lamport integer strings. Mirrors public.strategy_settings_valid(); generated by scripts/gen_settings.py.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "age_minutes_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 525600,
      "description": "Coin age upper bound, minutes"
    },
    "age_minutes_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 525600,
      "description": "Coin age lower bound, minutes"
    },
    "approval_mode": {
      "enum": [
        "off",
        "ask_first_buy",
        "ask_every_buy"
      ],
      "default": "ask_first_buy"
    },
    "avoid_practice_overlap": {
      "type": "boolean",
      "description": "Real copy: skip coins its practice twin holds or traded"
    },
    "bankroll_lamports": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$",
      "description": "Total strategy bankroll, lamports as an integer string (<= 100000 SOL)"
    },
    "bundled_share_pct_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Same-slot bundled share of supply, %; 0 = off"
    },
    "buy_to_sell_ratio_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "description": "Buys per sell (ratio)"
    },
    "change_1h_pct_max": {
      "type": "number",
      "minimum": -100,
      "maximum": 100000,
      "description": "1 h price change upper bound, %"
    },
    "change_1h_pct_min": {
      "type": "number",
      "minimum": -100,
      "maximum": 100000,
      "description": "1 h price change lower bound, %"
    },
    "change_1h_pct_preferred_high": {
      "type": "number",
      "minimum": -100,
      "maximum": 100000,
      "description": "Preferred 1 h change band, high end, %"
    },
    "change_1h_pct_preferred_low": {
      "type": "number",
      "minimum": -100,
      "maximum": 100000,
      "description": "Preferred 1 h change band, low end, %"
    },
    "creator_share_pct_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Creator wallet share of supply before the guard weighs it, %; 0 = off"
    },
    "deterministic_only": {
      "type": "boolean",
      "description": "No AI review step; rules decide alone"
    },
    "entry_discount_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 50,
      "description": "Wait for this % below the pick price before entering; 0 = immediately"
    },
    "entry_hours_utc": {
      "type": [
        "object",
        "null"
      ],
      "description": "Entry window in UTC hours (may wrap midnight); exits always run",
      "additionalProperties": false,
      "properties": {
        "start_hour": {
          "type": "number",
          "minimum": 0,
          "maximum": 23
        },
        "end_hour": {
          "type": "number",
          "minimum": 0,
          "maximum": 23
        }
      }
    },
    "entry_weekdays_utc": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      }
    },
    "exit_preset": {
      "enum": [
        "momentum_trail",
        "principal_recovery",
        "double_out",
        "three_step_ladder",
        "peak_giveback",
        "trail_stop_only",
        "incremental_trim",
        "fast_half",
        "fixed_thirty",
        "new_high_timeout",
        "ratchet",
        "tightening_trail",
        "geometric_ladder"
      ]
    },
    "exit_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "profit_targets": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "at_gain_pct",
              "sell_portion_pct"
            ],
            "additionalProperties": false,
            "properties": {
              "at_gain_pct": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 100000
              },
              "sell_portion_pct": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 100
              },
              "giveback_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "loss_guards": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "at_loss_pct",
              "sell_portion_pct"
            ],
            "additionalProperties": false,
            "properties": {
              "at_loss_pct": {
                "type": "number",
                "minimum": 1,
                "maximum": 99
              },
              "sell_portion_pct": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 100
              }
            }
          },
          "description": "Partial stops measured from the entry price, evaluated in ascending at_loss_pct"
        }
      }
    },
    "guard_checks": {
      "type": [
        "object",
        "null"
      ],
      "description": "Per-check guard overrides (GuardConfig field names)"
    },
    "holder_count_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000000.0,
      "description": "Holder count lower bound"
    },
    "idle_exit_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 5,
      "maximum": 3600,
      "description": "Exit after this many seconds without a trade; null = off"
    },
    "liquidity_usd_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000.0,
      "description": "Pool liquidity lower bound, USD"
    },
    "liveness_gate": {
      "type": [
        "object",
        "null"
      ],
      "description": "Enter only while the coin is actively trading",
      "additionalProperties": false,
      "properties": {
        "max_since_last_swap_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "min_active_5s_slots": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "min_recent_buyers": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "lp_burned_pct_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Burned share of the main pool's LP, %"
    },
    "max_concurrent_positions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Positions open at the same time"
    },
    "max_pool_impact_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Largest share of a pool one entry may take, %"
    },
    "mcap_usd_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000.0,
      "description": "Market cap upper bound, USD"
    },
    "mcap_usd_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000.0,
      "description": "Market cap lower bound, USD"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "observe_before_entry_minutes": {
      "type": "number",
      "minimum": 0,
      "maximum": 60,
      "description": "Watch a pick this long before entering; 0 = off"
    },
    "off_high_pct_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Largest allowed drop from the all-time high, %"
    },
    "one_minute_dump_pct_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 99,
      "description": "Skip coins with a 1-minute fall of this % in the last hour; 0 = off"
    },
    "peak_trail_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 49,
      "description": "Trailing stop: sell after this % drop from the position's PEAK; 0 = off, else 5\u201349"
    },
    "practice_drawdown_halt_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Practice: stop new entries after this % drop from peak equity; 0 = off"
    },
    "profit_targets": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "at_gain_pct",
          "sell_portion_pct"
        ],
        "additionalProperties": false,
        "properties": {
          "at_gain_pct": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 100000
          },
          "sell_portion_pct": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 100
          },
          "giveback_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "range_break_entry": {
      "type": [
        "object",
        "null"
      ],
      "description": "Enter on the break of a quiet range",
      "additionalProperties": false,
      "properties": {
        "window_minutes": {
          "type": "number",
          "minimum": 2,
          "maximum": 60
        },
        "max_range_pct": {
          "type": "number",
          "minimum": 2,
          "maximum": 100
        },
        "min_recent_buyers": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "real_drawdown_halt_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Real mode: stop new entries after this % drop from peak equity (default 50)"
    },
    "reentry": {
      "type": [
        "object",
        "null"
      ],
      "description": "Re-enter a coin after an exit",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "enum": [
            "retrace",
            "new_high",
            "any"
          ]
        },
        "settle_bars": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "watch_minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 1440
        },
        "after_loss": {
          "enum": [
            "halt",
            "continue"
          ]
        },
        "max_entries_per_coin": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "required_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "liquidity_usd",
          "volume_24h_usd",
          "mcap_usd",
          "age_minutes_min",
          "age_minutes_max",
          "top_holders_share_pct",
          "lp_burned_pct"
        ]
      },
      "description": "Checks that must pass outright instead of only scoring"
    },
    "revisit_after_move_pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 10000,
      "description": "Re-screen a rejected coin after this % move; null = default, 0 = never"
    },
    "score_threshold": {
      "type": "number",
      "minimum": 50,
      "maximum": 125,
      "description": "Weighted screen points needed to pass"
    },
    "screen_rules": {
      "type": [
        "object",
        "null"
      ],
      "description": "Screener rule set (config/screener.example.json format)"
    },
    "sell_floors": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Deterministic floors, evaluated before every other exit rule",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "max_loss_pct": {
          "type": "number",
          "minimum": 1,
          "maximum": 99,
          "default": 35
        },
        "liquidity_drop_pct": {
          "type": "number",
          "minimum": 1,
          "maximum": 99,
          "default": 80
        }
      }
    },
    "sell_pressure_exit": {
      "type": [
        "object",
        "null"
      ],
      "description": "Exit when a sell-dominated fall exceeds a threshold",
      "additionalProperties": false,
      "properties": {
        "fall_pct": {
          "type": "number",
          "minimum": 1,
          "maximum": 90
        },
        "window_minutes": {
          "enum": [
            1,
            5,
            60
          ]
        }
      }
    },
    "since_migration_seconds_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400,
      "description": "Seconds since leaving the launch curve; 0 = off"
    },
    "skip_if_risen_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "description": "Skip the entry if price rose this % since the pick; 0 = off"
    },
    "sniper_share_pct_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Early sniper share of supply, %; 0 = off"
    },
    "stall_exit": {
      "type": [
        "object",
        "null"
      ],
      "description": "Sell the whole position if |price change| over the last window_s seconds is below min_move_pct (exit_reason stall); null = off. Both fields required.",
      "additionalProperties": false,
      "properties": {
        "window_s": {
          "type": "integer",
          "minimum": 5,
          "maximum": 86400
        },
        "min_move_pct": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        }
      },
      "required": [
        "window_s",
        "min_move_pct"
      ]
    },
    "stop_loss_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 49,
      "description": "Hard stop: sell everything after this % loss from the ENTRY price; 0 = off, else 5\u201349 (v1.0 stopLossPct)"
    },
    "ticket_lamports": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$",
      "description": "Lamports per entry (0.001\u20131000 SOL), <= bankroll_lamports"
    },
    "time_stop_s": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 604800,
      "description": "Sell the whole position once it has been held this many seconds (exit_reason max_hold); null = off"
    },
    "top_holders_share_pct_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Share of supply held by the 10 largest holders, %"
    },
    "unique_buyers_1h_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000.0,
      "description": "Distinct buyer wallets in the last hour"
    },
    "venues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "curve",
          "amm"
        ]
      }
    },
    "volume_24h_usd_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000.0,
      "description": "24 h volume lower bound, USD"
    },
    "volume_to_mcap_1h_max": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "description": "1 h volume / market cap (ratio)"
    },
    "volume_to_mcap_1h_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "description": "1 h volume / market cap (ratio)"
    }
  }
}
