# Sentra backend — environment template. Copy to .env and fill in locally. NEVER commit .env.
# No private keys / seed phrases belong in any env var: Phase 1–6 are paper only.

# --- mode (anything other than "paper" makes the service refuse to start) ---
TRADING_MODE=paper

# --- tenancy for the ingest worker (Phase 1 runs single-workspace) ---
WORKSPACE_ID=local-dev
STRATEGY_ID=example
SCREENER_RULES_PATH=config/screener.example.json

# --- data sources ---
# comma list: helius | pumpportal | yellowstone (default: helius when HELIUS_API_KEY is set, else pumpportal)
INGEST_SOURCES=
HELIUS_API_KEY=
# base URLs WITHOUT the key (the key is appended from HELIUS_API_KEY and never logged)
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/
# yellowstone: pending provider choice (stub)
YELLOWSTONE_GRPC_URL=
YELLOWSTONE_X_TOKEN=
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# --- database (Supabase / Postgres). Service-role creds only on the backend. ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- pipeline tuning ---
INGEST_CHANNEL_CAPACITY=10000
# >0 runs a demo paper buy (SOL) for every coin that passes screener+guard; 0 = off
PAPER_DEMO_BUY_SOL=0
# Marks to the API SSE via pg_notify (display only). Unset MARKS_SOL_USD = off.
MARKS_SOL_USD=
MARKS_MIN_INTERVAL_MS=1000
SSE_MARKS_CHANNEL=sentra_marks

# --- approvals (server-owned TTL defaults; per-workspace overrides live in DB) ---
PICK_PROPOSAL_TTL_SECONDS=600
GUARD_PROPOSAL_TTL_SECONDS=86400
TEAM_ACTION_TTL_SECONDS=3600
APPROVAL_TOKEN_MAX_TTL_SECONDS=900

# --- guard impact: static estimate always on; full replay only when p95 < 2 s holds ---
GUARD_REPLAY_ENABLED=false
GUARD_REPLAY_MAX_SAMPLES=50000
GUARD_REPLAY_WINDOW_DAYS=7

# --- auth (Edge Functions). Generate locally; never reuse across environments. ---
OTP_PEPPER=
TELEGRAM_BOT_TOKEN=
# Telegram OIDC login: design-only until Boss approves the security review
AUTH_TELEGRAM_OIDC_ENABLED=false
TELEGRAM_CLIENT_ID=
TELEGRAM_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
TELEGRAM_ID_TOKEN_MAX_AGE_SECONDS=120
SIWS_ALLOWED_DOMAINS=localhost
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000

# --- practice reset / account deletion ---
PRACTICE_START_LAMPORTS=30000000000
PRACTICE_RESET_COOLDOWN_HOURS=24
# server-side only; 7-30 (enforced in SQL), default 7 (Apex's decision as lead)
ACCOUNT_DELETION_GRACE_DAYS=7

# --- push (Phase 5) ---
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=

# --- Phase 7 gates (must stay false until Boss approves Real SOL) ---
LIVE_EXECUTION_ENABLED=false
LIVE_GUARD_WEAKENING_ENABLED=false

# --- observability ---
RUST_LOG=info
LOG_FORMAT=text

# --- Wallet login (SIWS) and sessions (API) ---
# Domains (host[:port]) allowed in the SIWS message; empty = SIWS login disabled (503).
AUTH_SIWS_DOMAINS=localhost:3000
# Optional owner allowlist: comma-separated base58 wallet addresses. Empty = any wallet may sign in.
OWNER_WALLETS=
AUTH_ACCESS_TTL_S=900
AUTH_REFRESH_TTL_S=2592000
# Only behind a trusted reverse proxy: take the client IP (rate limits) from X-Forwarded-For.
TRUST_PROXY=false
# Dropped from the MVP (routes 404 while false; no implementation).
AUTH_EMAIL_OTP_ENABLED=false
# New wallet users: supabase_admin (production; needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY) or direct (local tests only)
AUTH_USER_CREATE=supabase_admin
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
