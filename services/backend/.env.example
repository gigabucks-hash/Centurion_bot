# solbot — environment template. Copy to .env and fill in locally. NEVER commit .env.
# No private keys / seed phrases belong in any env var: Phase 1–6 are paper only.

# --- mode (anything other than "paper" makes the service refuse to start) ---
TRADING_MODE=paper

# --- tenancy for the ingest worker (Phase 1 runs single-workspace) ---
WORKSPACE_ID=local-dev
STRATEGY_ID=example
SCREENER_RULES_PATH=config/screener.example.json

# --- data sources ---
HELIUS_API_KEY=
YELLOWSTONE_GRPC_URL=
YELLOWSTONE_X_TOKEN=
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# --- database (Supabase / Postgres). Service-role creds only on the backend. ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- pipeline tuning ---
INGEST_CHANNEL_CAPACITY=10000
# >0 runs a demo paper buy (SOL) for every coin that passes screener+guard; 0 = off
PAPER_DEMO_BUY_SOL=0

# --- approvals (server-owned TTL defaults; per-workspace overrides live in DB) ---
PICK_PROPOSAL_TTL_SECONDS=600
GUARD_PROPOSAL_TTL_SECONDS=86400

# --- Phase 7 gates (must stay false until Boss approves Real SOL) ---
LIVE_EXECUTION_ENABLED=false
LIVE_GUARD_WEAKENING_ENABLED=false

# --- observability ---
RUST_LOG=info
LOG_FORMAT=text
